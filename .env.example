# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real credentials.

# ── LLM Providers (only set the ones you use) ────────────
#
# Option A: Nvidia NIM (FREE cloud — get key at https://build.nvidia.com)
#   No GPU or Docker needed. Uses 70B models for free.
NVIDIA_API_KEY=nvapi-...

# Option B: OpenAI (paid)
# OPENAI_API_KEY=sk-...

# Option C: Anthropic (paid)
# ANTHROPIC_API_KEY=sk-ant-...

# Option D: OpenRouter (paid aggregator — one key, many models)
# OPENROUTER_API_KEY=sk-or-...

# Option E: Ollama (FREE, fully local — no key needed, just `ollama serve`)
#   See https://ollama.com for install instructions

# ── Self-hosted endpoint overrides (optional) ───────────
# OLLAMA_HOST=http://localhost:11434
# OPENAI_BASE_URL=https://api.openai.com/v1
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1        # free cloud (default)
# NVIDIA_BASE_URL=http://localhost:8000/v1                   # self-hosted NIM (air-gapped)
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ── GitHub Integration ───────────────────────────────────
GITHUB_TOKEN=ghp_...
GITHUB_REPOSITORY=owner/repo
PR_NUMBER=42
